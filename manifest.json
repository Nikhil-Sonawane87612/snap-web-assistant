{
  "manifest_version": 3,
  "name": "Snap Web Assistant",
  "version": "1.0.0",
  "description": "Local-only screenshot-bypass and media saver for Snapchat Web. Nothing leaves your browser.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://web.snapchat.com/*",
    "https://www.snapchat.com/web/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snap Web Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://web.snapchat.com/*", "https://www.snapchat.com/web/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://web.snapchat.com/*", "https://www.snapchat.com/web/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
